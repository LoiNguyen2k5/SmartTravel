@startuml SmartTravel_UseCase_Diagram
' Bố cục từ trái sang phải: Actor người dùng bên trái -> Khung hệ thống ở giữa -> Actor hệ thống/Admin bên phải
left to right direction

skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 12
skinparam handwritten false
skinparam actorStyle awesome

' Tùy chỉnh màu sắc đường nối và Actor
skinparam sequence {
    ArrowColor #0284c7
    ActorBorderColor #0f172a
}

skinparam usecase {
    BackgroundColor #f0fdf4
    BorderColor #16a34a
    FontName Arial
    FontSize 12
    ArrowColor #2563eb
}

skinparam rectangle {
    BackgroundColor #ffffff
    BorderColor #0284c7
    BorderThickness 2
    FontColor #0f172a
    FontSize 14
    FontStyle bold
}

' ========================================================
' 1. CÁC ACTOR BÊN TRÁI (NGƯỜI DÙNG CHÍNH: KHÁCH HÀNG & VENDOR)
' ========================================================
actor "Khách Hàng\n(Customer)" as User #SkyBlue
actor "Đại Lý Du Lịch\n(Vendor)" as Vendor #LightGreen

' ========================================================
' 2. KHUNG HỆ THỐNG TRUNG TÂM (SYSTEM BOUNDARY)
' ========================================================
rectangle "HỆ THỐNG NỀN TẢNG DU LỊCH SMARTTRAVEL" as System {

    ' ----------------------------------------------------
    ' Phân hệ Dùng chung & Xác thực
    ' ----------------------------------------------------
    package "Xác Thực & Tài Khoản" {
        usecase "Đăng ký / Đăng nhập (JWT & OTP)" as UC_Auth
        usecase "Quản lý hồ sơ cá nhân & Đổi mật khẩu" as UC_Profile
    }

    ' ----------------------------------------------------
    ' Phân hệ Khách hàng (Customer)
    ' ----------------------------------------------------
    package "Phân Hệ Khách Hàng" {
        usecase "Tìm kiếm & Lọc tour đa tiêu chí" as UC_Search
        usecase "Xem chi tiết tour & Lịch trình" as UC_ViewDetail
        usecase "Tra cứu thông tin thủ tục Visa du lịch" as UC_ViewVisaInfo
        usecase "Đặt tour & Đăng ký hỗ trợ Visa" as UC_Booking
        usecase "Kiểm tra & Khóa giữ slot (Real-time)" as UC_HoldSlot
        usecase "Thanh toán đa kênh (VietQR / Thẻ Visa)" as UC_Payment
        usecase "Tự động đối soát thanh toán (Webhook)" as UC_AutoConfirm
        usecase "Nhận & Tra cứu Vé điện tử (E-Ticket QR)" as UC_ETicket
        usecase "Xem lịch sử đặt tour & Trạng thái đơn" as UC_BookingHistory
        usecase "Đánh giá sao & Đăng ảnh thực tế" as UC_Review
    }

    ' ----------------------------------------------------
    ' Phân hệ Đại lý du lịch (Vendor)
    ' ----------------------------------------------------
    package "Phân Hệ Đại Lý (Vendor)" {
        usecase "Nộp hồ sơ đăng ký đại lý Vendor" as UC_RegisterVendor
        usecase "Đăng bán tour du lịch mới" as UC_CreateTour
        usecase "Cập nhật tour & Thư viện ảnh (Cloudinary)" as UC_UpdateTour
        usecase "Cấu hình chính sách & Hồ sơ xin Visa" as UC_ConfigVisa
        usecase "Quản lý lịch khởi hành & Giá vé" as UC_ManageSchedule
        usecase "Quản lý đơn đặt chỗ & Check-in vé" as UC_ManageBookings
        usecase "Thống kê doanh thu & Tỷ lệ lấp đầy" as UC_VendorStats
    }

    ' ----------------------------------------------------
    ' Phân hệ Quản trị sàn (Admin)
    ' ----------------------------------------------------
    package "Phân Hệ Quản Trị Sàn (Admin)" {
        usecase "Quản lý người dùng & Phân quyền RBAC" as UC_ManageUsers
        usecase "Phê duyệt hồ sơ đối tác Vendor" as UC_ApproveVendor
        usecase "Kiểm duyệt nội dung tour đăng bán" as UC_ModerateTour
        usecase "Quản trị danh mục địa danh du lịch" as UC_ManageDestinations
        usecase "Theo dõi dòng tiền & Đối soát hoa hồng" as UC_Settlement
        usecase "Báo cáo Dashboard doanh thu toàn sàn" as UC_AdminDashboard
    }

    ' ----------------------------------------------------
    ' Phân hệ Tích hợp Trí tuệ nhân tạo (AI Services)
    ' ----------------------------------------------------
    package "Phân Hệ Trí Tuệ Nhân Tạo (Gemini AI)" {
        usecase "Chatbot AI tư vấn tour & FAQ Visa" as UC_AIChatbot
        usecase "AI gợi ý lịch trình cá nhân hóa" as UC_AIItinerary
        usecase "AI sinh nội dung mô tả tour chuẩn SEO" as UC_AIGenerator
        usecase "AI phân tích cảm xúc đánh giá (Sentiment)" as UC_AISentiment
    }

    ' Các quan hệ nghiệp vụ nội bộ <<include>> / <<extend>>
    UC_Booking .> UC_HoldSlot : <<include>>
    UC_Booking .> UC_Payment : <<include>>
    UC_Payment .> UC_AutoConfirm : <<include>>
    UC_Payment .> UC_ETicket : <<include>>
    UC_ViewDetail .> UC_ViewVisaInfo : <<extend>>
    UC_Review .> UC_BookingHistory : <<extend>>
    UC_CreateTour .> UC_ConfigVisa : <<include>>
    UC_CreateTour .> UC_AIGenerator : <<extend>>
    UC_ModerateTour .> UC_AISentiment : <<extend>>
    UC_ViewDetail .> UC_AIItinerary : <<extend>>
}

' ========================================================
' 3. CÁC ACTOR BÊN PHẢI (ADMIN & CÁC HỆ THỐNG NGOÀI)
' ========================================================
actor "Quản Trị Viên\n(Admin)" as Admin #Tomato
actor "Cổng Thanh Toán\n(VietQR / Visa Gateway)" as BankGateway #Gold
actor "Google Gemini API\n(AI Cloud Service)" as AIService #MediumOrchid

' ========================================================
' 4. LIÊN KẾT: ACTOR BÊN TRÁI NỐI VÀO HỆ THỐNG (-->)
' ========================================================
' Khách hàng
User --> UC_Auth
User --> UC_Profile
User --> UC_Search
User --> UC_ViewDetail
User --> UC_Booking
User --> UC_BookingHistory
User --> UC_ETicket
User --> UC_Review
User --> UC_AIChatbot

' Đại lý Vendor
Vendor --> UC_Auth
Vendor --> UC_Profile
Vendor --> UC_RegisterVendor
Vendor --> UC_CreateTour
Vendor --> UC_UpdateTour
Vendor --> UC_ManageSchedule
Vendor --> UC_ManageBookings
Vendor --> UC_VendorStats

' ========================================================
' 5. LIÊN KẾT: HỆ THỐNG NỐI RA ACTOR BÊN PHẢI (<--)
' ========================================================
' Admin
UC_Auth <-- Admin
UC_ManageUsers <-- Admin
UC_ApproveVendor <-- Admin
UC_ModerateTour <-- Admin
UC_ManageDestinations <-- Admin
UC_Settlement <-- Admin
UC_AdminDashboard <-- Admin

' Cổng thanh toán (VietQR / Webhook / Visa)
UC_AutoConfirm <-- BankGateway

' AI Service (Google Gemini API)
UC_AIChatbot <-- AIService
UC_AIItinerary <-- AIService
UC_AIGenerator <-- AIService
UC_AISentiment <-- AIService

@enduml
